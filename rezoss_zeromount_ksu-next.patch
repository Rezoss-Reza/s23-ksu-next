+int zeromount_spoof_statfs(const char __user *pathname, struct kstatfs *buf)
+{
+	char *kpath;
+	char *resolved;
+	int ret = 0;
+
+	if (zeromount_should_skip() ||
+	    zeromount_is_uid_blocked(current_uid().val))
+		return 0;
+#ifdef CONFIG_KSU_SUSFS
+	if (susfs_is_current_proc_umounted())
+		return 0;
+#endif
