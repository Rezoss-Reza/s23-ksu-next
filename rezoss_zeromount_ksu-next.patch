+static inline void zm_bloom_add(u32 hash)
+{
+	set_bit(hash & ZM_BLOOM_MASK, zm_bloom);
+	set_bit((hash >> 10) & ZM_BLOOM_MASK, zm_bloom);
+	set_bit((hash >> 20) & ZM_BLOOM_MASK, zm_bloom);
+}
+
+static inline bool zm_bloom_test(u32 hash)
+{
