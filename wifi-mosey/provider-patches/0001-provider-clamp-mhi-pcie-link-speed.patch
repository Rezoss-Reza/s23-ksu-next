 	}
+	/* cnss2 may load before or after us; arm now and on its LIVE event. */
+	if (!register_module_notifier(&bw_clamp_nb))
+		bw_clamp_arm();
 	return 0;
 }
 
 static void __exit s23u_provider_exit(void)
 {
+	unregister_module_notifier(&bw_clamp_nb);
+	bw_clamp_disarm();
 	platform_device_unregister(frontend_device);
 	cnss_set_vendor_wonder_priv_data(NULL);
 	platform_device_unregister(provider_device);
