diff --git a/kernel/feature/sucompat.c b/kernel/feature/sucompat.c
--- a/kernel/feature/sucompat.c
+++ b/kernel/feature/sucompat.c
@@ -133,6 +133,25 @@ static char __user *sh_user_path(void)
 {
 	return userspace_stack_buffer(sh_path, sizeof(sh_path));
 }
+
+/*
+ * KernelSU-Next dev moved these helpers ahead of the sucompat syscall
+ * handlers. Patch 70's legacy CONFIG_KSU_SUSFS guard can therefore hide
+ * the upstream definitions when it applies with fuzz. Keep equivalents in
+ * the SUSFS branch so the remaining upstream handlers still compile.
+ */
+static char __user *empty_user_path(void)
+{
+	return userspace_stack_buffer("", sizeof(""));
+}
+
+static bool is_ksud_exists(void)
+{
+	struct path path;
+
+	if (kern_path(KSUD_PATH, 0, &path) < 0)
+		return false;
+	path_put(&path);
+	return true;
+}
 
